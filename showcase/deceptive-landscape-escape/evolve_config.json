{
  "description": "Evolve optimal bit string solutions - deceptive landscape demo",
  "mode": "perf",
  "evaluation": {
    "test_command": "python evaluate.py {solution} --json"
  },
  "memory": {
    "enabled": true,
    "inject_mutation_context": true,
    "store_failed_mutations": true
  },
  "trust": {
    "enabled": true,
    "require_adversary_for_champion": true
  },
  "diversity": {
    "enabled": true,
    "genotypic_threshold": 0.25,
    "phenotypic_threshold": 0.20,
    "check_interval": 1,
    "auto_inject": true,
    "max_injections_per_alert": 2
  },
  "starter_solutions": ["baseline.py"],
  "max_generations": 10,
  "population_size": 6,
  "mutation_variants": 3
}
